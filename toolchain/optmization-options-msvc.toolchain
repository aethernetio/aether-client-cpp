# User-editable CMake toolchain draft for MSVC.
#
# Select it explicitly with:
# cmake -S . -B <build-dir> -DCMAKE_TOOLCHAIN_FILE=<path-to-this-file>
#
# These directory-wide options affect every target created after this toolchain
# is loaded, including dependencies. They apply only to Release builds.

# MSVC compile and link options.
set(_msvc_compile_options /fp:fast /O1 /DNDEBUG /Gy /Gw /GL)
set(_msvc_cxx_compile_options /EHsc- /GR-)
add_compile_options(
    "$<$<AND:$<CONFIG:Release>,$<COMPILE_LANG_AND_ID:C,MSVC>>:${_msvc_compile_options}>"
    "$<$<AND:$<CONFIG:Release>,$<COMPILE_LANG_AND_ID:CXX,MSVC>>:${_msvc_compile_options};${_msvc_cxx_compile_options}>")

set(_msvc_link_options /LTCG /OPT:REF /INCREMENTAL:NO)
add_link_options(
    "$<$<AND:$<CONFIG:Release>,$<CXX_COMPILER_ID:MSVC>>:${_msvc_link_options}>")
