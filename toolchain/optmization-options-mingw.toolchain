# User-editable CMake toolchain draft for MinGW.
#
# Select it explicitly with:
# cmake -S . -B <build-dir> -DCMAKE_TOOLCHAIN_FILE=<path-to-this-file>
#
# This profile uses conservative GCC/MinGW release compiler options. Do not add
# Linux/GNU linker stripping, section garbage collection, LTO, or aggressive
# math options here: MinGW uses a distinct Windows toolchain and linker
# environment.

set(_mingw_compile_options
    -pipe
    -fomit-frame-pointer
    -DNDEBUG)

add_compile_options(
    "$<$<AND:$<CONFIG:Release>,$<COMPILE_LANG_AND_ID:C,GNU>>:${_mingw_compile_options}>"
    "$<$<AND:$<CONFIG:Release>,$<COMPILE_LANG_AND_ID:CXX,GNU>>:${_mingw_compile_options}>")
