# User-editable CMake toolchain draft for AppleClang.
#
# Select it explicitly with:
# cmake -S . -B <build-dir> -DCMAKE_TOOLCHAIN_FILE=<path-to-this-file>
#
# These directory-wide options affect every target created after this toolchain
# is loaded, including dependencies. They apply only to Release builds.

# AppleClang compile options.
set(_appleclang_compile_options
    -ffast-math
    # These explicit math flags are intentionally selected for this toolchain.
    -fno-math-errno
    -funsafe-math-optimizations
    -fassociative-math
    -freciprocal-math
    -ffinite-math-only
    -fno-signed-zeros
    -fno-trapping-math
    -DNDEBUG
    -fdata-sections
    -ffunction-sections
    -Os
    -flto)
set(_appleclang_cxx_compile_options -fno-exceptions -fno-rtti)

add_compile_options(
    "$<$<AND:$<CONFIG:Release>,$<COMPILE_LANG_AND_ID:C,AppleClang>>:${_appleclang_compile_options}>"
    "$<$<AND:$<CONFIG:Release>,$<COMPILE_LANG_AND_ID:CXX,AppleClang>>:${_appleclang_compile_options};${_appleclang_cxx_compile_options}>")

# AppleClang link options.
set(_appleclang_link_options
    -fdata-sections
    -ffunction-sections
    -flto
    -Wl,-dead_strip
    -Wl,-x)
add_link_options(
    "$<$<AND:$<CONFIG:Release>,$<CXX_COMPILER_ID:AppleClang>>:${_appleclang_link_options}>")
